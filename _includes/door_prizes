{% comment %}
*
*   Door prize giveaway card. To use this include no `.html` ending is necessary.
*
*       {% include door_prizes %}
*
*   Pass `cta_url` and `cta_text` to show a button at the bottom of the card:
*
*       {% include door_prizes cta_url="/register/" cta_text="Register to get your entry" %}
*
{% endcomment %}
<style>
.door-prizes {
  margin: 28px 0;
  border: 2px solid #d63638;
  border-radius: 10px;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}
.door-prizes__banner {
  margin: 0;
  padding: 10px 16px;
  background: #d63638;
  color: #fff;
  font-weight: 700;
  font-size: 15px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-align: center;
}
.door-prizes__grand {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px 24px;
  padding: 20px 20px 8px;
  background: #fff;
}
.door-prizes__img {
  flex: 1 1 280px;
  max-width: 420px;
  margin: 0 auto;
}
.door-prizes__img img {
  display: block;
  width: 100%;
  height: auto;
}
.door-prizes__details {
  flex: 1 1 260px;
}
.door-prizes__label {
  display: inline-block;
  margin: 0 0 6px;
  padding: 2px 10px;
  border-radius: 999px;
  background: #1f2937;
  color: #fff;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.door-prizes__details h3 {
  margin: 4px 0 6px;
  font-size: 26px;
  line-height: 1.2;
}
.door-prizes__msrp {
  margin: 0 0 8px;
  font-size: 18px;
}
.door-prizes__msrp strong {
  color: #d63638;
}
.door-prizes__sponsor {
  margin: 0;
  font-size: 15px;
  color: #444;
}
.door-prizes__runner {
  margin: 0 20px;
  padding: 14px 0;
  border-top: 1px dashed #ddd;
}
.door-prizes__runner h4 {
  margin: 4px 0 0;
  font-size: 20px;
}
.door-prizes__more {
  padding: 16px 20px 20px;
  border-top: 1px dashed #ddd;
}
.door-prizes__more-title {
  margin: 0 0 4px;
  font-size: 20px;
  text-align: center;
}
.door-prizes__more-total {
  margin: 0 0 14px;
  text-align: center;
  font-size: 16px;
}
.door-prizes__more-total strong {
  color: #d63638;
}
.door-prizes__cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
}
@media (max-width: 560px) {
  .door-prizes__cards {
    grid-template-columns: 1fr;
  }
}
.door-prizes__card {
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  background: #fafafa;
  overflow: hidden;
}
.door-prizes__card h4 {
  margin: 0;
  padding: 8px 12px;
  background: #1f2937;
  color: #fff;
  font-size: 15px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.door-prizes__card h4 a {
  color: #fff;
}
.door-prizes__card-value {
  margin: 0;
  padding: 8px 12px 0;
  font-size: 15px;
  font-weight: 700;
  color: #d63638;
}
.door-prizes__card ul {
  margin: 6px 12px 12px 28px;
}
.door-prizes__card li {
  margin-bottom: 2px;
  font-size: 15px;
}
.door-prizes__more-note {
  margin: 12px 0 0;
  font-size: 13px;
  color: #666;
  text-align: center;
}
.door-prizes__rules {
  margin: 0;
  padding: 16px 20px 18px;
  background: #f6f6f6;
}
.door-prizes__rules ul {
  margin: 0 0 0 20px;
}
.door-prizes__rules li {
  margin-bottom: 4px;
  font-size: 15px;
}
.door-prizes__cta {
  margin: 12px 0 0;
  text-align: center;
}
</style>

<section class="door-prizes" id="door-prizes">
  <p class="door-prizes__banner">2026 Rally Door Prizes</p>

  <div class="door-prizes__grand">
    <div class="door-prizes__img">
      <img src="{{ site.urlimg }}gasgas_moto1_ebike_725_588.png" alt="Red 2024 GASGAS Moto 1 electric bike" width="725" height="588">
    </div>
    <div class="door-prizes__details">
      <span class="door-prizes__label">Grand Prize</span>
      <h3>2024 GASGAS Moto 1 E&#8209;Bike</h3>
      <p class="door-prizes__msrp">A <strong>$2,599 MSRP</strong> value!</p>
      <p class="door-prizes__sponsor">Generously donated by <a href="https://www.gjktm.com/" target="_blank" rel="noopener noreferrer">Teddy Morse's Grand Junction Powersports</a></p>
    </div>
  </div>

  <div class="door-prizes__runner">
    <span class="door-prizes__label">Runner Up</span>
    <h4>$250 <a href="https://www.klim.com/" target="_blank" rel="noopener noreferrer">Klim</a> Gift Card</h4>
  </div>

  <div class="door-prizes__more">
    <h3 class="door-prizes__more-title">Plus More Prizes from Our Sponsors!</h3>
    <p class="door-prizes__more-total">Over <strong>$3,000</strong> in additional prizes</p>
    <div class="door-prizes__cards">
      <div class="door-prizes__card">
        <h4><a href="https://www.bajadesigns.com/" target="_blank" rel="noopener noreferrer">Baja Designs</a></h4>
        <p class="door-prizes__card-value">~$2,600 in prizes</p>
        <ul>
          <li>2&times; Moto Minded XL80 LED Headlight Kit</li>
          <li>2&times; Moto Minded XL40 LED Headlight Kit</li>
          <li>S1 Spot LEDs (pair)</li>
          <li>2&times; S1 Trail LED</li>
          <li>S1 Wide Cornering LEDs (pair)</li>
        </ul>
      </div>
      <div class="door-prizes__card">
        <h4><a href="https://www.doubletakemirror.com/" target="_blank" rel="noopener noreferrer">DoubleTake Mirrors</a></h4>
        <p class="door-prizes__card-value">~$180 in prizes</p>
        <ul>
          <li>Dual Sport Mirror 3.5 Kit</li>
          <li>Enduro Mirror 2.0 Kit</li>
          <li>2&times; Trail Mirror</li>
        </ul>
      </div>
      <div class="door-prizes__card">
        <h4><a href="https://www.all-terrainmoto.com/" target="_blank" rel="noopener noreferrer">All Terrain Motorsports</a></h4>
        <p class="door-prizes__card-value">~$150 in prizes</p>
        <ul>
          <li>3&times; Hats</li>
          <li>2&times; Goggles</li>
          <li>1 pair of gloves</li>
          <li>1 pair of FMF sunglasses</li>
        </ul>
      </div>
      <div class="door-prizes__card">
        <h4><a href="https://coloradotpa.org/" target="_blank" rel="noopener noreferrer">Trails Preservation Alliance</a></h4>
        <p class="door-prizes__card-value">~$100 in prizes</p>
        <ul>
          <li>Silky Big Boy folding saw</li>
        </ul>
      </div>
    </div>
    <p class="door-prizes__more-note">Values are approximate retail prices.</p>
  </div>

  <div class="door-prizes__rules">
    <ul>
      <li><strong>One entry for every ride you sign up for</strong> - ride Saturday <em>and</em> Sunday to double your chances!</li>
      <li>Entry is automatic with registration - no extra tickets or forms</li>
      <li><strong>Drawing:</strong> Saturday, October 17th at 6:00 PM at the 27-1/4 Road MX Track event area</li>
      <li><strong style="color: #d63638;">You must be present to win!</strong></li>
    </ul>
    {% if include.cta_url %}
    <p class="door-prizes__cta"><a class="radius button small alert" href="{{ include.cta_url }}">{{ include.cta_text | default: "Register to get your entry" }}</a></p>
    {% endif %}
  </div>
</section>
